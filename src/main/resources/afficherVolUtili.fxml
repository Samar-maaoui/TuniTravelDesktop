<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.afficherVolUtiliController">
    <children>
        <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
            <!-- Titre -->
            <Label text="Liste des Vols" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: black;" />

            <!-- Barre de recherche -->
            <HBox alignment="CENTER" spacing="10">
                <DatePicker fx:id="dateDepartField" promptText="Date Départ" prefWidth="150" />
                <DatePicker fx:id="dateArriveeField" promptText="Date Arrivée" prefWidth="150" />
                <Button text="Chercher" onAction="#chercherVol" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10px 20px;" />
                <Button text="Trier" onAction="#trierVols" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10px 20px;" />
            </HBox>

            <!-- Liste des vols -->
            <VBox style="-fx-background-color: transparent;">
                <ListView fx:id="listViewVols" style="-fx-background-color: transparent;"/>
            </VBox>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="15">
                <Button text="Recharger" onAction="#afficherVols" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 10px;" />


                <Button fx:id="btnhelp" text="helpbot" onAction="#gotohelp" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 10px;" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
