<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ajouterReservationVolController">    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
            <!-- Titre -->
            <Label text="Ajouter une réservation" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <!-- Sélection de la classe de service -->
            <HBox spacing="10">
                <Label text="Classe Service:" />
                <ComboBox fx:id="classeServiceComboBox" />
            </HBox>

            <!-- Bouton Ajouter -->
            <Button text="Ajouter Réservation" onAction="#ajouterReservation" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 10px;" />
        </VBox>
    </children>
</AnchorPane>
