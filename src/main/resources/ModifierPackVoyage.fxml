<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ModifierPackVoyageController"   style="-fx-background-color: white;"
>

    <children>
        <!-- Label Titre -->
        <Label layoutX="250.0" layoutY="30.0" text="Modifier un Pack Voyage"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1565c0;" />

        <!-- Champs de saisie avec valeurs pré-remplies -->
        <Label layoutX="50.0" layoutY="80.0" text="Nom du Pack :" />
        <TextField fx:id="nomField" layoutX="200.0" layoutY="75.0" prefWidth="400.0" promptText="Cliquez pour modifier..." />

        <Label layoutX="50.0" layoutY="130.0" text="Description :" />
        <TextField fx:id="descriptionField" layoutX="200.0" layoutY="125.0" prefWidth="400.0" promptText="Cliquez pour modifier..." />

        <Label layoutX="50.0" layoutY="180.0" text="Prix Total (€) :" />
        <TextField fx:id="prixField" layoutX="200.0" layoutY="175.0" prefWidth="400.0" promptText="Cliquez pour modifier..." />

        <Label layoutX="50.0" layoutY="230.0" text="Nombre de Places :" />
        <TextField fx:id="placesField" layoutX="200.0" layoutY="225.0" prefWidth="400.0" promptText="Cliquez pour modifier..." />

        <Label layoutX="50.0" layoutY="280.0" text="Sélectionnez un Vol :" />
        <ComboBox fx:id="comboVol" layoutX="200.0" layoutY="275.0" prefWidth="400.0" />

        <Label layoutX="50.0" layoutY="330.0" text="Sélectionnez un Hôtel :" />
        <ComboBox fx:id="comboHotel" layoutX="200.0" layoutY="325.0" prefWidth="400.0" />

        <Label layoutX="50.0" layoutY="380.0" text="Sélectionnez une Excursion :" />
        <ComboBox fx:id="comboExcursion" layoutX="200.0" layoutY="375.0" prefWidth="400.0" />

        <!-- Boutons -->
        <Button fx:id="btnAnnuler" layoutX="200.0" layoutY="440.0" prefWidth="120.0" onAction="#handleAnnuler"
                style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold;" text="Annuler" />

        <Button fx:id="btnModifier" layoutX="480.0" layoutY="440.0" prefWidth="120.0" onAction="#handleModifier"
                style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" text="Modifier" />
    </children>
</AnchorPane>
