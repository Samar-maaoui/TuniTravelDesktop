<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuVolsController">
    <top>
        <HBox alignment="TOP_CENTER" spacing="15" styleClass="border-bottom" stylesheets="@/style.css" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20" BorderPane.alignment="CENTER">
            <children>
                <VBox onMouseClicked="#gotoAfficherEvenement" prefHeight="44.0" prefWidth="214.0">
                    <children>
                        <ImageView fitHeight="26.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets left="60.0" right="20.0" top="20.0" />
                            </VBox.margin>
                            <image>
                                <Image url="@images/liste-a-puces.png" />
                            </image>
                        </ImageView>
                        <Label prefHeight="17.0" prefWidth="29.0" text="Vols">
                            <VBox.margin>
                                <Insets left="60.0" top="5.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <VBox layoutX="127.0" layoutY="10.0" onMouseClicked="#goToDisplayReservations" prefHeight="85.0" prefWidth="117.0">
                    <children>
                        <ImageView fitHeight="26.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets left="55.0" right="20.0" top="20.0" />
                            </VBox.margin>
                            <image>
                                <Image url="@images/reserve.png" />
                            </image>
                        </ImageView>
                        <Label prefHeight="17.0" prefWidth="107.0" text=" Mes Reservations">
                            <VBox.margin>
                                <Insets left="20.0" top="5.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" BorderPane.alignment="CENTER">
            <content>
                <AnchorPane fx:id="contentArea" minHeight="600.0" minWidth="800.0" />
            </content>
        </ScrollPane>
    </center>
</BorderPane>
