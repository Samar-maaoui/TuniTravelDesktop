<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CarteExcursionController">
   <children>
      <HBox layoutX="96.0" layoutY="34.0" prefHeight="331.0" prefWidth="407.0">
         <children>
            <ImageView fx:id="imageExcursion" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            <VBox fx:id="infoContainer" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nomExcursion" text="Label" />
                  <Label fx:id="lieuExcursion" text="Label" />
                  <Label fx:id="prixExcursion" text="Label" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
