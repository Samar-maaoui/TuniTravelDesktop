<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@/styles/designe.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ajouter_hotelController"
            style="-fx-background-color: #f8f9fa;">

    <!-- En-tête -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2E8B57; -fx-padding: 20px;">
            <Label text="Ajouter un Nouvel Hôtel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <AnchorPane>
            <VBox alignment="CENTER" spacing="20" styleClass="form-container" AnchorPane.topAnchor="50.0"
                  AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30" />
                </padding>
                <Label fx:id="lblMessage" styleClass="message-label" />

                <Label text="Informations de l'Hôtel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;"/>

                <TextField fx:id="txtNom" promptText="Nom" styleClass="text-field"
                           style="-fx-pref-width: 500; -fx-pref-height: 40; -fx-font-size: 14px;"/>

                <TextField fx:id="txtPrix" promptText="Prix/Nuit" styleClass="text-field"
                           style="-fx-pref-width: 500; -fx-pref-height: 40; -fx-font-size: 14px;"/>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Disponibilité:" style="-fx-font-size: 14px;"/>
                    <ToggleButton fx:id="btnDisponible" text="Indisponible" styleClass="toggle-button"
                                  style="-fx-pref-height: 40; -fx-font-size: 14px;"/>
                </HBox>

                <TextField fx:id="txtAdresse" promptText="Adresse" styleClass="text-field"
                           style="-fx-pref-width: 500; -fx-pref-height: 40; -fx-font-size: 14px;"/>

                <TextArea fx:id="txtDescription" promptText="Description" styleClass="text-area"
                          style="-fx-pref-width: 500; -fx-pref-height: 100; -fx-font-size: 14px;"/>

                <TextField fx:id="txtTel" promptText="Téléphone" styleClass="text-field"
                           style="-fx-pref-width: 500; -fx-pref-height: 40; -fx-font-size: 14px;"/>

                <TextField fx:id="txtEmail" promptText="Email" styleClass="text-field"
                           style="-fx-pref-width: 500; -fx-pref-height: 40; -fx-font-size: 14px;"/>

                <TextField fx:id="txtImageUrl" promptText="Image URL" styleClass="text-field"
                           style="-fx-pref-width: 500; -fx-pref-height: 40; -fx-font-size: 14px;"/>
                <Button fx:id="btnChoisirImage" text="Choisir une image" styleClass="button"/>



                <!-- Boutons d'action -->
                <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnAjouter" text="Ajouter Hôtel" onAction="#ajouterHotel" styleClass="button"
                            style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12 25; -fx-background-radius: 5;"/>
                    <Button fx:id="btnAnnuler" text="Annuler" onAction="#fermerFenetre" styleClass="button-danger"
                            style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12 25; -fx-background-radius: 5;"/>
                </HBox>

                <!-- Bouton retour en haut -->
                <Button text="Retour" onAction="#fermerFenetre" styleClass="button-danger"
                        style="-fx-background-color: transparent; -fx-text-fill: #6c757d; -fx-border-color: #6c757d; -fx-border-radius: 5; -fx-font-size: 14px; -fx-padding: 8 15;"/>
            </VBox>
        </AnchorPane>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #2E8B57; -fx-padding: 10px;">
            <Label text="Système de Gestion Hôtelière" style="-fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>