<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AfficherEvenementController">


    <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="ALWAYS" layoutY="76.0" maxHeight="Infinity" maxWidth="Infinity" prefHeight="504.0" prefWidth="760.0" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="76.0">
        <VBox fx:id="eventCardsContainer" alignment="CENTER" prefHeight="515.0" prefWidth="758.0" spacing="20">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
         <children>



             <HBox alignment="CENTER" />
         </children>
        </VBox>
    </ScrollPane>
    <TextField fx:id="searchTextField" onKeyReleased="#filterEvents" prefHeight="40" prefWidth="200" promptText="Rechercher par nom" AnchorPane.leftAnchor="240" AnchorPane.topAnchor="20" />
    <ComboBox fx:id="categoryFilter" layoutX="54.0" layoutY="14.0" onAction="#filterEvents" prefHeight="20" prefWidth="150" promptText="Filtrer par catégorie" AnchorPane.leftAnchor="54.0" AnchorPane.topAnchor="14.0">
      <padding>
         <Insets bottom="10.0" left="20.0" right="20.0" />
      </padding>
      <opaqueInsets>
         <Insets />
      </opaqueInsets></ComboBox>
    <Button layoutX="690.0" layoutY="20.0" mnemonicParsing="false" onMouseClicked="#goToCalendar" prefHeight="41.0" prefWidth="60.0" text="📅" AnchorPane.rightAnchor="40"
            style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-border-radius: 5; -fx-background-radius: 5;" />




    <!-- Add Button at the bottom center -->
    <HBox alignment="CENTER" layoutX="350.0" layoutY="550.0" />

    <Button fx:id="btnAjouter" onAction="#goToAjouter" prefHeight="60" prefWidth="60" styleClass="add-button" text="➕" visible="false" AnchorPane.bottomAnchor="40" AnchorPane.rightAnchor="40" />
</AnchorPane>
