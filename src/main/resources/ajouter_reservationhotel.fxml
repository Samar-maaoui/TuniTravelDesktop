<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ajouter_reservationhotelController"
            style="-fx-background-color: #f8f9fa;">

    <!-- En-tête -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2E8B57; -fx-padding: 20px;">
            <Label text="Ajouter une Réservation" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50px;">
            <GridPane alignment="CENTER" hgap="20" vgap="25">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150" />
                    <ColumnConstraints minWidth="300" />
                </columnConstraints>

                <!-- Date d'arrivée -->
                <Label text="Date d'Arrivée :" style="-fx-font-size: 16px; -fx-text-fill: #495057;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <DatePicker fx:id="dpCheckIn" style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px;"
                            GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <!-- Date de départ -->
                <Label text="Date de Départ :" style="-fx-font-size: 16px; -fx-text-fill: #495057;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <DatePicker fx:id="dpCheckOut" style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px;"
                            GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <!-- Type de chambre -->
                <Label text="Type de Chambre :" style="-fx-font-size: 16px; -fx-text-fill: #495057;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="cbTypeChambre" style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px;"
                          GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <!-- Affichage du prix -->
                <Label text="Prix :" style="-fx-font-size: 16px; -fx-text-fill: #495057;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <HBox alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <Label fx:id="lblPrix" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;"/>
                </HBox>
            </GridPane>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="30" style="-fx-padding: 30px 0 0 0;">
                <Button fx:id="btnAjouter" text="Ajouter Réservation" onAction="#ajouterReservation"
                        style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12 25; -fx-background-radius: 5;"/>
                <Button fx:id="btnAnnuler" text="Annuler" onAction="#annuler"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12 25; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #2E8B57; -fx-padding: 10px;">
            <Label text="Système de Réservation" style="-fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>
