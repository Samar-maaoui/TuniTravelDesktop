<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="550.0"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AjouterPackVoyageController" fx:id="rootPane"
            style="-fx-background-color: white;">

    <children>
        <!-- Titre -->
        <Label layoutX="50.0" layoutY="20.0" text="Ajouter un Pack Voyage"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1565c0;" />

        <!-- Champs de saisie -->
        <Label layoutX="30.0" layoutY="60.0" text="Nom du Pack :" />
        <TextField fx:id="nomField" layoutX="160.0" layoutY="55.0" prefWidth="300.0"
                   promptText="Nom du pack" />

        <Label layoutX="30.0" layoutY="100.0" text="Description :" />
        <TextField fx:id="descriptionField" layoutX="160.0" layoutY="95.0" prefWidth="300.0"
                   promptText="Ajoutez une description" />

        <Label layoutX="30.0" layoutY="140.0" text="Prix (€) :" />
        <TextField fx:id="prixField" layoutX="160.0" layoutY="135.0" prefWidth="300.0"
                   promptText="Prix total" />

        <Label layoutX="30.0" layoutY="180.0" text="Places :" />
        <TextField fx:id="placesField" layoutX="160.0" layoutY="175.0" prefWidth="300.0"
                   promptText="Nombre de places" />

        <Label layoutX="30.0" layoutY="220.0" text="Vol :" />
        <ComboBox fx:id="comboVol" layoutX="160.0" layoutY="215.0" prefWidth="300.0"/>

        <Label layoutX="30.0" layoutY="260.0" text="Hôtel :" />
        <ComboBox fx:id="comboHotel" layoutX="160.0" layoutY="255.0" prefWidth="300.0"/>

        <Label layoutX="30.0" layoutY="300.0" text="Excursion :" />
        <ComboBox fx:id="comboExcursion" layoutX="160.0" layoutY="295.0" prefWidth="300.0"/>

        <!-- Section pour l'Image -->
        <Label layoutX="30.0" layoutY="340.0" text="Image :" />
        <Button fx:id="btnChoisirImage" layoutX="160.0" layoutY="335.0" text="Choisir Image"
                onAction="#handleChoisirImage"/>
        <ImageView fx:id="imageView" layoutX="280.0" layoutY="330.0" fitHeight="80.0" fitWidth="120.0"
                   style="-fx-border-color: gray;" />

        <!-- Boutons -->
        <Button fx:id="btnRetour" layoutX="100.0" layoutY="420.0" prefWidth="120.0"
                onAction="#handleRetour"
                style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Retour" />

        <Button fx:id="btnAjouter" layoutX="280.0" layoutY="420.0" prefWidth="120.0"
                onAction="#handleAjouter"
                style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Ajouter" />
    </children>
</AnchorPane>


