<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.TrelloController"
            prefWidth="850" prefHeight="500"
            stylesheets="@trello.css">

    <!-- Conteneur principal -->
    <VBox spacing="15" layoutX="10" layoutY="10" prefWidth="830" prefHeight="480">

        <!-- Titre principal -->
        <Label text="📌 Gestion des Réservations" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Zone de listes -->
        <HBox spacing="15">
            <VBox>
                <Label text="📍 Réservations en attente" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ListView fx:id="listeEnAttente" prefWidth="250" prefHeight="280"/>
            </VBox>

            <VBox>
                <Label text="✅ Réservations confirmées" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ListView fx:id="listeConfirmees" prefWidth="250" prefHeight="280"/>
            </VBox>

            <VBox>
                <Label text="❌ Réservations annulées" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ListView fx:id="listeAnnulees" prefWidth="250" prefHeight="280"/>
            </VBox>
        </HBox>

        <!-- Zone des boutons -->
        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="btnDelete" text="Supprimer Carte" onAction="#deleteCard"
                    styleClass="action-button"/>

            <Button fx:id="btnSync" text="🔄 Synchroniser avec Trello" onAction="#synchroniserReservations"
                    styleClass="sync-button"/>
        </HBox>

    </VBox>
</AnchorPane>
