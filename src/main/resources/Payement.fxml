<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.PayementController"
            prefHeight="400.0" prefWidth="600.0">
    <GridPane alignment="center" hgap="10" vgap="10">
        <Label text="Montant à payer (TND) :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="amountField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Payer" fx:id="payButton" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="paymentStatus" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

</AnchorPane>
