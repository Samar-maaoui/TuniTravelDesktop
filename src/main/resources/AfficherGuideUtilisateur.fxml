<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<AnchorPane prefHeight="712.0" prefWidth="812.0" style="-fx-background-color: #e9f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AfficherGuideUtilisateur">
    <stylesheets>
        <URL value="@stylee.css" />
    </stylesheets>
    <children>
        <!-- ListView affichant les éléments -->
        <ListView fx:id="listView" layoutX="14.0" layoutY="90.0" prefHeight="534.0" prefWidth="344.0" style="-fx-border-color: #12989e; -fx-background-color: F5F5F5;">
            <effect>
                <DropShadow>
                    <color>
                        <Color red="0.75789475440979" green="0.75789475440979" blue="0.75789475440979" />
                    </color>
                </DropShadow>
            </effect></ListView>

        <!-- Section de détail pour le guide sélectionné -->
        <ScrollPane layoutX="370.0" layoutY="101.0" prefHeight="454.0" prefWidth="387.0" style="-fx-border-color: #12989e;">
            <content>
                <VBox fx:id="detailsVBox" prefHeight="406.0" prefWidth="331.0" spacing="5.0">
                    <!-- Les informations du guide seront affichées ici -->
                    <ImageView fx:id="guideImageView" fitHeight="135.0" fitWidth="359.0" pickOnBounds="true" preserveRatio="true" />
                    <HBox fx:id="guideNameHBox" spacing="10">
                        <children>
                            <Label fx:id="nameLabel" prefHeight="23.0" prefWidth="362.0" style="-fx-font-size: 20;" text="Nom du Guide" textFill="CHOCOLATE" />
                        </children>
                    </HBox>
                    <Label fx:id="langueLabel" prefHeight="23.0" prefWidth="346.0" style="-fx-font-size: 20;" text="Langue" textFill="CHOCOLATE" />
                    <Label fx:id="email" prefHeight="23.0" prefWidth="327.0" style="-fx-font-size: 20;" text="Email" textFill="CHOCOLATE" />
                    <Label fx:id="Telephone" prefHeight="23.0" prefWidth="355.0" style="-fx-font-size: 20;" text="Telephone" textFill="CHOCOLATE" />
                </VBox>
            </content>
        </ScrollPane>
        <Label contentDisplay="CENTER" layoutX="14.0" layoutY="14.0" prefHeight="47.0" prefWidth="344.0" style="-fx-font-size: 40;" text="𝐋𝐢𝐬𝐭𝐞 𝐝𝐞𝐬 𝐠𝐮𝐢𝐝𝐞𝐬" textFill="#12989e" underline="true" />
    </children>
</AnchorPane>
